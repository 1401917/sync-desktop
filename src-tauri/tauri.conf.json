{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sync",
  "version": "0.1.0",
  "identifier": "dev.sync.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sync",
        "width": 920,
        "height": 560,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
